@startuml
' Logical source of truth for the public architecture graphic.
' The companion SVG controls the exact web composition before WebP export.
left to right direction

skinparam dpi 180
skinparam backgroundColor #0D151D
skinparam shadowing false
skinparam roundCorner 14
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #E9EEF3
skinparam ArrowFontName Arial
skinparam ArrowFontSize 12
skinparam ArrowFontColor #C7D0D9
skinparam ArrowThickness 2
skinparam packageStyle rectangle
skinparam PackageBackgroundColor #111A23
skinparam PackageBorderColor #FFA500
skinparam PackageFontColor #FFA500
skinparam PackageFontStyle bold
skinparam RectangleBackgroundColor #17212C
skinparam RectangleBorderColor #465565
skinparam RectangleFontColor #F4F4F4
skinparam DatabaseBackgroundColor #172A22
skinparam DatabaseBorderColor #63DC78
skinparam DatabaseFontColor #F4F4F4
skinparam QueueBackgroundColor #2A2414
skinparam QueueBorderColor #FFA500
skinparam QueueFontColor #F4F4F4
skinparam LegendBackgroundColor #111A23
skinparam LegendBorderColor #35424F
skinparam LegendFontColor #C7D0D9

title <color:#FFA500><size:24><b>AUTOMATION RELEASE CONTROL</b></size></color>\n<color:#F4F4F4><size:16>From releasable Git commit to verified machine state</size></color>

rectangle "<color:#AAB6C2><size:11><b>EXTERNAL QUALITY PROCESS</b></size></color>\n\n<size:15><b>PLC software validation</b></size>\n<size:12>Validates and approves applications + libraries</size>\n<size:12>before a Git version becomes releasable</size>\n\n<color:#7F8B98><size:11>Outside Automation Release Control</size></color>" as QUALITY #202933

package "AUTOMATION RELEASE CONTROL  ·  GAMP 5 QUALIFIED SYSTEM" as ARC {
    rectangle "<color:#FFA500><size:11><b>01  OPERATOR WORKSTATION</b></size></color>\n\n<size:16><b>Angular frontend</b></size>\n<size:12>MVVM interface</size>\n<size:11>Release selection  ·  Fleet status</size>" as UI #102B3D

    rectangle "<color:#FFA500><size:11><b>02  APPLICATION SERVER</b></size></color>\n\n<size:16><b>C# / ASP.NET</b></size>\n<size:12>Release API + orchestration</size>\n<size:11>Target commands  ·  State ingestion</size>" as API #102B3D

    database "<color:#8BE69B><size:11><b>03  GIT HOST</b></size></color>\n\n<size:16><b>Remote repository</b></size>\n<size:12>Releasable PLC software + libraries</size>\n<size:11>Selected commit = target  ·  Previous commit = rollback</size>" as HOST #172A22

    rectangle "<color:#8BE69B><size:11><b>04  CLIENT COMPUTER</b></size></color>\n\n<size:16><b>Git client + deployment service</b></size>\n<size:12>Fetches and checks out selected commit</size>\n<size:11>Working copy defines the deployed version</size>" as CLIENT #172A22

    UI -right-> API #42A5D5;line.bold;text:C7D0D9 : <b>HTTPS</b>\nrelease command + target
    API -right-> HOST #42A5D5;line.bold;text:C7D0D9 : select target commit
    HOST -down-> CLIENT #63DC78;line.bold;text:C7D0D9 : <b>Git over SSH</b>\nfetch + checkout
}

rectangle "<color:#FFC052><size:11><b>05  PLC / MACHINE</b></size></color>\n\n<size:16><b>PLC application + libraries</b></size>\n<size:12>Machine and runtime state</size>\n<size:11>Reports running version + operating status</size>" as PLC #2A2414

queue "<color:#FFC052><size:11><b>STATE FEEDBACK</b></size></color>\n\n<size:15><b>OPC UA / MQTT</b></size>\n<size:11>Running version + machine status</size>" as FEEDBACK #2A2414

QUALITY -down-> HOST #7F8B98;line.dashed;text:C7D0D9 : releasable Git version
CLIENT -right-> PLC #63DC78;line.bold;text:C7D0D9 : deploy selected version
PLC -down-> FEEDBACK #FFA500;line.bold;text:C7D0D9 : read machine state
FEEDBACK -up-> API #FFA500;line.bold;text:C7D0D9 : return installed state
API -left-> UI #FFA500;line.bold;text:C7D0D9 : update frontend

legend bottom
  |= Color |= Meaning |
  |<#42A5D5>  | Application control |
  |<#63DC78>  | Git version deployment |
  |<#FFA500>  | Machine-state feedback |
  |<#7F8B98>  | External validation boundary |
endlegend

@enduml
